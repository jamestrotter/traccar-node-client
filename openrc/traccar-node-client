#!/sbin/openrc-run

description="Traccar Node Client"

command="/usr/bin/node"
command_args="/opt/traccar-node-client/index.js"
command_user="root"
pidfile="/run/traccar-node-client.pid"
command_background=true

output_log="/var/log/traccar-node-client.log"
error_log="/var/log/traccar-node-client.log"

respawn
respawn_delay=5
respawn_max=10

depend() {
    need net gpsd
}
